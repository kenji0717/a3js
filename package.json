{
  "name": "a3js",
  "version": "0.0.59",
  "type": "module",
  "main": "dist/a3js.cjs.js",
  "module": "dist/a3js.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/a3js.es.js",
      "require": "./dist/a3js.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "docs:api": "typedoc",
    "docs:site": "test -d docs/api && cp -r docs/api docs-src/public/api && vitepress build docs-src --outDir docs && rm -fr docs-src/public/api",
    "docs": "npm run docs:api && npm run docs:site"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "typedoc": "^0.28.19",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitepress": "^1.6.4",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "fflate": "^0.8.3",
    "three": "^0.184.0"
  },
  "dependencies": {
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
