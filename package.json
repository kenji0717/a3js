{
  "name": "a3js",
  "version": "0.0.18",
  "type": "module",
  "main": "dist/a3js.cjs.js",
  "module": "dist/a3js.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/a3js.es.js",
      "require": "./dist/a3js.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "docs": "typedoc && vitepress build docs-src --outDir docs && rm -r docs-src/public/api"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "typedoc": "^0.28.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "fflate": "^0.8.2",
    "three": "^0.182.0"
  }
}
